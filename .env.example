APP_NAME="A-Code Solutions - Plataforma Evaluadora"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=acs_exam_web
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Sesion/cola/cache en file y sync para no depender de tablas extra ni
# de un worker corriendo durante la demo.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Laravel Reverb (MPW-V2 S1.3.4: contenedor "reverb" en compose.yaml, via
# Sail). No hay ninguna funcion del demo que dependa de esto todavia
# (no se emite ningun evento en vivo), pero el servidor arranca y el
# contenedor existe, conforme al stack oficial de 3 contenedores.
REVERB_APP_ID=acs-exam-web
REVERB_APP_KEY=acsexamwebkey
REVERB_APP_SECRET=acsexamwebsecret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@acode-solutions.test"
MAIL_FROM_NAME="${APP_NAME}"

# Evaluador de IA para preguntas abiertas/codigo (RW-09/RW-10). En DEMO se
# usa el driver "mock" (sin llave) para no depender de internet ni de una
# API key real durante la expo; cambiar a "gemini" + AI_API_KEY cuando se
# tenga la integracion real.
AI_EVALUATOR_DRIVER=mock
AI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
